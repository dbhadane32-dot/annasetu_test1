# Local development. Copy to .env (never commit .env).
FLASK_DEBUG=1
HOST=host from Aiven
PORT=19312
MYSQL_HOST=host from Aiven
MYSQL_PORT=19312
MYSQL_USER=user from Aiven
MYSQL_PASSWORD=change_this_password
MYSQL_DATABASE=defaultdb
CO2_PER_KG=2.5
# Local only: allows the "Reset demo data" button. Keep 0 online.
ALLOW_DEMO_RESET=1
# Only needed if the frontend is hosted on a different site (e.g. GitHub Pages):
# CORS_ORIGINS=https://yourname.github.io
# Hosted MySQL options: MYSQL_SSL_DISABLED=1 (if the host has no SSL) or MYSQL_SSL_CA=/path/ca.pem
